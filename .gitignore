# Exported large checkpoint embeddings (regenerated by embed_export.py)
实验/中间产物/嵌入/*.pt
实验/中间产物/嵌入_补充/*.pt
实验/中间产物/checkpoints/

# Raw MOOCCubeX dumps (>50MB)
实验/数据/

# Runtime logs
实验/日志/*.log
实验/日志/*.jsonl
