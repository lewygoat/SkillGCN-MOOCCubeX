# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# OS & archive metadata
.DS_Store
__MACOSX/
._*
Thumbs.db

# Unpacked large graph tensor (auto-extracted from s6_graph.pt.gz)
